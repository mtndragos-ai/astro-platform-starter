    window.addEventListener('load', function() {
        const loginForm = document.getElementById('custom-login-form');
        const loginBtn = document.getElementById('custom-login-btn');
        const errorMsg = document.getElementById('error-message');
        const userField = document.getElementById('username');
        const passField = document.getElementById('password');

        if(loginForm) {
            loginForm.addEventListener('submit', () => {
                // Ascundem erorile vechi
                if(errorMsg) errorMsg.style.display = 'none';
                
                // Efect vizual
                const originalText = loginBtn.innerHTML;
                loginBtn.innerHTML = 'Se verifică...';
                loginBtn.style.opacity = '0.8';

                // Luăm valorile scrise de user (curățăm spațiile goale)
                const username = userField.value.trim().toLowerCase();
                const password = passField.value.trim();

                // Simulam putin timp de asteptare (0.5s) pentru un efect mai profi
                setTimeout(() => {
                    // VERIFICAREA MAGICĂ (Există user-ul în listă și corespunde parola?)
                    if (validUsers.hasOwnProperty(username) && validUsers[username] === password) {
                        
                        // Succes! Salvam Sesiunea.
                        localStorage.setItem('agro_session', 'true');
                        localStorage.setItem('agro_session_date', new Date().toDateString());
                        localStorage.setItem('agro_user', username);

                        // Înregistrare în Analytics (dacă există)
                        import('../utils/analytics.js').then(module => {
                            if(module.Analytics && module.Analytics.trackLogin) {
                                module.Analytics.trackLogin(username);
                            }
                        }).catch(() => { });

                        // Redirecționare
                        window.location.href = '/categorii';

                    } else {
                        // Date greșite
                        showError("Utilizator sau parolă incorectă!");
                        shakeForm();
                        
                        // Resetăm butonul
                        loginBtn.innerHTML = originalText;
                        loginBtn.style.opacity = '1';
                    }
                }, 500);
            });
        }

        function showError(message) {
            if(errorMsg) {
                errorMsg.innerHTML = message;
                errorMsg.style.display = 'block';
            }
        }

        function shakeForm() {
            const card = document.querySelector('.login-card-modern');
            if(card) {
                card.style.animation = 'shake 0.5s';
                setTimeout(() => card.style.animation = '', 500);
            }
        }
    });
</script>

<style is:global>
    body { margin: 0; padding: 0; }

    .login-page-fullscreen {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        display: flex; align-items: center; justify-content: center;
        background-color: #f8fafc;
        background-image: radial-gradient(#cbd5e1 1.5px, transparent 1.5px);
        background-size: 28px 28px;
        font-family: 'Roboto', sans-serif;
        z-index: 9999;
    }

    .login-card-modern {
        background: #ffffff; padding: 3.5rem 3rem; border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0,0,0,0.05);
        width: 100%; max-width: 440px; text-align: center;
        border: 1px solid #e2e8f0; box-sizing: border-box;
    }

    .logo-container { display: flex; flex-direction: column; align-items: center; margin-bottom: 2rem; }
    .brand-text { font-weight: 900; font-size: 2.2rem; letter-spacing: -0.5px; color: #0f172a; line-height: 1;}
    .blue { color: #003087; } .yellow { color: #F4D03F; }
    .training-text { font-weight: 300; font-size: 1.6rem; color: #9ca3af; text-transform: uppercase; margin-top: -2px;}

    .login-header h1 { font-size: 1.6rem; color: #0f172a; margin: 0 0 10px 0; font-weight: 800; letter-spacing: -0.5px; }
    .login-header p { color: #64748b; font-size: 1rem; margin: 0 0 2.5rem 0; line-height: 1.5; font-weight: 400; }

    /* FORMULAR DESIGN NOU */
    .custom-login-form { display: flex; flex-direction: column; gap: 1.5rem; text-align: left; }
    
    .input-group { display: flex; flex-direction: column; gap: 6px; }
    .input-group label { font-size: 0.9rem; font-weight: 700; color: #1e293b; }
    .input-group input { 
        width: 100%; padding: 12px 14px; border-radius: 10px; border: 2px solid #e2e8f0; 
        font-family: inherit; font-size: 1rem; color: #0f172a; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
        box-sizing: border-box;
    }
    .input-group input:focus { border-color: #003087; box-shadow: 0 0 0 3px rgba(0, 48, 135, 0.1); }
    .input-group input::placeholder { color: #94a3b8; }

    .custom-btn-solid {
        width: 100%; background: #003087; color: white; border: none; padding: 14px;
        font-size: 1.05rem; font-weight: 700; border-radius: 10px; cursor: pointer;
        transition: all 0.2s ease; font-family: inherit; margin-top: 0.5rem;
    }
    .custom-btn-solid:hover { background: #002366; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0, 48, 135, 0.2); }
    .custom-btn-solid:active { transform: translateY(0); }

    .error-msg-box { margin-top: 1.5rem; padding: 14px; background-color: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 12px; font-size: 0.95rem; font-weight: 500; line-height: 1.4; }

    @keyframes shake { 0% { transform: translateX(0); } 25% { transform: translateX(-5px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-5px); } 100% { transform: translateX(0); } }

    @media (max-width: 480px) {
        .login-card-modern { padding: 2.5rem 1.5rem; max-width: 90%; }
        .brand-text { font-size: 1.8rem; }
        .training-text { font-size: 1.3rem; }
    }
</style>