---
import Layout from '../layouts/Layout.astro';
---

<!-- SCRIPT NOU: Verifică automat dacă sesiunea e de azi -->
<script is:inline>
    const today = new Date().toDateString();
    const sessionDate = localStorage.getItem('agro_session_date');

    // Dacă este deja logat și data coincide cu cea de azi, îl trimitem direct în platformă
    if (localStorage.getItem('agro_session') && sessionDate === today) {
        window.location.replace('/categorii');
    } else {
        // Dacă e a doua zi (sau nu e logat deloc), curățăm preventiv memoria veche
        localStorage.removeItem('agro_session');
        localStorage.removeItem('agro_user');
        localStorage.removeItem('agro_session_date');
    }
</script>

<Layout title="AgroConcept Service">
    <div class="login-page-fullscreen">
        <div class="login-card-modern">
            <div class="logo-container">
                <div class="brand-text"><span class="blue">AGRO</span><span class="yellow">CONCEPT</span></div>
                <span class="training-text">SERVICE</span>
            </div>

            <div class="login-header">
                <h1>Acces Restricționat</h1>
                <p>Această platformă este destinată exclusiv angajaților AgroConcept.</p>
            </div>

            <!-- BUTONUL MAGIC MICROSOFT -->
            <button id="ms-login-btn" class="microsoft-btn-outline">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 21 21">
                    <path fill="#f25022" d="M1 1h9v9H1z"/>
                    <path fill="#00a4ef" d="M1 11h9v9H1z"/>
                    <path fill="#7fba00" d="M11 1h9v9h-9z"/>
                    <path fill="#ffb900" d="M11 11h9v9h-9z"/>
                </svg>
                Logare cu contul de Outlook
            </button>

            <div id="error-message" class="error-msg-box" style="display: none;"></div>
        </div>
    </div>
</Layout>

<!-- Script pentru Autentificare Firebase cu MICROSOFT -->
<script type="module">
    // Importăm modulele Firebase
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-app.js";
    import { getAuth, signInWithPopup, OAuthProvider, signOut } from "https://www.gstatic.com/firebasejs/10.8.1/firebase-auth.js";

    // 🚨 DATELE TALE FIREBASE FUNCTIONALE 🚨
    const firebaseConfig = {
        apiKey: "AIzaSyBHJXPg7aUmhNaP2_KHjluzADBoDIoU24Q",
        authDomain: "autentificare-23aa8.firebaseapp.com",
        projectId: "autentificare-23aa8",
        storageBucket: "autentificare-23aa8.firebasestorage.app",
        messagingSenderId: "175988924637",
        appId: "1:175988924637:web:1782dcb4141deb42b23b34",
        measurementId: "G-DQFXCF3H5L"
    };

    // Inițializare Firebase
    let app;
    const errorMsg = document.getElementById('error-message');
    
    try {
        app = initializeApp(firebaseConfig);
    } catch(e) {
        console.error("Eroare la inițializarea Firebase. Verifică configurația.", e);
        showError("Configurația de autentificare lipsește. Contactați administratorul.");
    }

    const auth = getAuth(app);
    
    // Setăm providerul pentru MICROSOFT
    const provider = new OAuthProvider('microsoft.com');
    
    provider.setCustomParameters({
        prompt: 'select_account',
    });

    const loginBtn = document.getElementById('ms-login-btn');

    // DOMENIUL ACCEPTAT PENTRU LOGIN
    const ALLOWED_DOMAIN = '@agroconcept.ro';

    if(loginBtn) {
        loginBtn.addEventListener('click', () => {
            // Ascundem erorile vechi
            if(errorMsg) errorMsg.style.display = 'none';
            loginBtn.innerHTML = 'Se procesează...';
            loginBtn.style.opacity = '0.7';

            // Deschidem fereastra securizată de logare Microsoft
            signInWithPopup(auth, provider)
                .then((result) => {
                    const userEmail = result.user.email;

                    // VERIFICAREA MAGICĂ: Este adresa oficială a companiei?
                    if (userEmail && userEmail.toLowerCase().endsWith(ALLOWED_DOMAIN)) {
                        
                        localStorage.setItem('agro_session', 'true');
                        
                        // 🌟 SETĂM DATA CURENTĂ PENTRU A EXPIRA LA MIEZUL NOPȚII 🌟
                        localStorage.setItem('agro_session_date', new Date().toDateString());
                        
                        // Extragem numele dinainte de @ (ex: ion.popescu)
                        const username = userEmail.split('@')[0];
                        localStorage.setItem('agro_user', username);

                        // Înregistrare în Analytics
                        import('../utils/analytics.js').then(module => {
                            if(module.Analytics && module.Analytics.trackLogin) {
                                module.Analytics.trackLogin(userEmail);
                            }
                        }).catch(() => { });

                        window.location.href = '/categorii';

                    } else {
                        // Dacă s-a logat cu un alt cont, îl dăm afară și dăm eroare
                        signOut(auth).then(() => {
                            showError(`Acces interzis. Adresa <b>${userEmail}</b> nu aparține companiei AgroConcept.`);
                            shakeForm();
                        });
                    }
                })
                .catch((error) => {
                    console.error("Eroare autentificare Microsoft:", error);
                    if (error.code !== 'auth/popup-closed-by-user') {
                        showError("A apărut o eroare la conectare. Verificați conexiunea și încercați din nou.");
                        shakeForm();
                    }
                })
                .finally(() => {
                    // Resetare buton la starea inițială
                    loginBtn.innerHTML = `
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 21 21">
                            <path fill="#f25022" d="M1 1h9v9H1z"/>
                            <path fill="#00a4ef" d="M1 11h9v9H1z"/>
                            <path fill="#7fba00" d="M11 1h9v9h-9z"/>
                            <path fill="#ffb900" d="M11 11h9v9h-9z"/>
                        </svg>
                        Logare cu contul de Outlook
                    `;
                    loginBtn.style.opacity = '1';
                });
        });
    }

    function showError(message) {
        if(errorMsg) {
            errorMsg.innerHTML = message;
            errorMsg.style.display = 'block';
        }
    }

    function shakeForm() {
        const card = document.querySelector('.login-card-modern');
        if(card) {
            card.style.animation = 'shake 0.5s';
            setTimeout(() => card.style.animation = '', 500);
        }
    }
</script>

<!-- Folosim is:global pentru a forța suprascrierea fundalului închis din Layout.astro -->
<style is:global>
    body {
        margin: 0;
        padding: 0;
    }

    .login-page-fullscreen {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8fafc;
        background-image: radial-gradient(#cbd5e1 1.5px, transparent 1.5px);
        background-size: 28px 28px;
        font-family: 'Roboto', sans-serif;
        z-index: 9999; /* Ne asigurăm că stă peste orice alt element din Layout */
    }

    .login-card-modern {
        background: #ffffff;
        padding: 3.5rem 3rem;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 440px;
        text-align: center;
        border: 1px solid #e2e8f0;
        box-sizing: border-box;
    }

    .logo-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 2rem;
    }
    .brand-text { font-weight: 900; font-size: 2.2rem; letter-spacing: -0.5px; color: #0f172a; line-height: 1;}
    .blue { color: #003087; }
    .yellow { color: #F4D03F; }
    .training-text { font-weight: 300; font-size: 1.6rem; color: #9ca3af; text-transform: uppercase; margin-top: -2px;}

    .login-header h1 {
        font-size: 1.6rem;
        color: #0f172a;
        margin: 0 0 10px 0;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .login-header p {
        color: #64748b;
        font-size: 1rem;
        margin: 0 0 2.5rem 0;
        line-height: 1.5;
        font-weight: 400;
    }

    .microsoft-btn-outline {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: #ffffff;
        color: #0f172a;
        border: 2px solid #0f172a;
        padding: 14px;
        font-size: 1.05rem;
        font-weight: 700;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
    }

    .microsoft-btn-outline:hover {
        background: #f8fafc;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
        transform: translateY(-2px);
    }
    
    .microsoft-btn-outline:active {
        transform: translateY(0);
    }

    .error-msg-box {
        margin-top: 1.5rem;
        padding: 14px;
        background-color: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 500;
        line-height: 1.4;
    }

    @keyframes shake { 0% { transform: translateX(0); } 25% { transform: translateX(-5px); } 50% { transform: translateX(5px); } 75% { transform: translateX(-5px); } 100% { transform: translateX(0); } }

    @media (max-width: 480px) {
        .login-card-modern {
            padding: 2.5rem 1.5rem;
            max-width: 90%;
        }
        .brand-text { font-size: 1.8rem; }
        .training-text { font-size: 1.3rem; }
    }
</style>