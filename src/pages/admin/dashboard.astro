---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Dashboard Statistici | Management">
    <div class="admin-container">
        <!-- HEADER ADMIN -->
        <header class="admin-header">
            <div class="header-inner">
                <div class="brand-info">
                    <div class="title-with-status">
                        <h1>📊 Control Management</h1>
                        <div class="live-pulse">
                            <span class="pulse-dot"></span>
                            <span id="status-text">LIVE</span>
                        </div>
                    </div>
                    <p>Monitorizare activitate tehnicieni în timp real</p>
                </div>
                <div class="header-actions">
                    <button id="refresh-btn" class="refresh-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
                        Actualizează
                    </button>
                    <a href="/categorii" class="back-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        Înapoi
                    </a>
                </div>
            </div>
        </header>

        <main class="stats-content">
            <!-- CARDURI STATISTICE PRINCIPALE -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon users">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">UTILIZATORI ACTIVI</span>
                        <span class="stat-value" id="total-users">0</span>
                        <div class="stat-indicator pos">În data selectată</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon downloads">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">TOTAL ACȚIUNI</span>
                        <span class="stat-value" id="total-actions">0</span>
                        <div class="stat-indicator">În data selectată</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon time">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div class="stat-info">
                        <span class="stat-label">ULTIMA SINCRONIZARE</span>
                        <span class="stat-value" id="last-update" style="font-size: 2rem; margin-top: 10px;">--:--</span>
                        <div class="stat-indicator">Date preluate din Google Sheets</div>
                    </div>
                </div>
            </div>

            <!-- SECȚIUNE PREMIUM: PREZENȚĂ TEHNICIENI -->
            <section class="active-users-section">
                <div class="active-users-header">
                    <div class="icon-wrapper">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <div class="header-text-group">
                        <h3 class="section-title">Prezență Tehnicieni</h3>
                        <p class="section-desc">Colegii care au accesat platforma în data selectată</p>
                    </div>
                </div>
                <div id="active-users-list" class="users-chips-container">
                    <span class="loading-text">Se încarcă lista prezenței...</span>
                </div>
            </section>

            <!-- FEED ACTIVITATE (ACCORDION MODERN) -->
            <section class="activity-section">
                <div class="section-header">
                    <h2>Flux Activitate Detaliată</h2>
                    <!-- Input interactiv pentru selectarea datei -->
                    <input type="date" id="date-picker" class="date-badge" />
                </div>

                <div class="feed-container-modern">
                    <div id="live-feed" class="accordion-wrapper">
                        <div style="padding: 4rem 2rem; text-align: center; color: #64748b; font-weight: 600; background: white; border-radius: 16px;">
                            Se încarcă datele din sistem...
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</Layout>

<script is:inline>
    // =========================================================================
    // ⚠️ LIPEȘTE AICI LINK-UL OBȚINUT DE LA GOOGLE APPS SCRIPT
    // =========================================================================
    const SHEETS_API_URL = "https://script.google.com/macros/s/AKfycbzQKnNXhg-ujruAchI0CoAEJwnLw2e88pJwau4cfpw36ngCWWYHX2BbkRKLkQIfajVV/exec"; 

    function formatDateForSearch(dateStr) {
        const parts = dateStr.split('-');
        if (parts.length === 3) return `${parts[2]}.${parts[1]}.${parts[0]}`; 
        return dateStr;
    }

    // Funcția modernizată care deschide/închide panoul fiecărui utilizator
    window.toggleAccordion = function(contentId, cardId) {
        const body = document.getElementById(contentId);
        const card = document.getElementById(cardId);
        
        if (body.style.maxHeight && body.style.maxHeight !== '0px') {
            // Închidere
            body.style.maxHeight = '0px';
            card.classList.remove('is-open');
        } else {
            // Deschidere lină
            body.style.display = 'block';
            card.classList.add('is-open');
            body.style.maxHeight = body.scrollHeight + 1000 + 'px'; // +1000 pt siguranță la resize
            
            // Reajustăm maxHeight după scurt timp pt flexibilitate completă
            setTimeout(() => { if(card.classList.contains('is-open')) body.style.maxHeight = 'none'; }, 400);
        }
    };

    window.addEventListener('load', () => {
        const datePicker = document.getElementById('date-picker');

        const today = new Date();
        const dd = String(today.getDate()).padStart(2, '0');
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const yyyy = today.getFullYear();
        datePicker.value = `${yyyy}-${mm}-${dd}`;
        
        datePicker.addEventListener('click', function(e) {
            e.preventDefault();
            if (typeof this.showPicker === 'function') this.showPicker();
        });
        
        fetchData();
        document.getElementById('refresh-btn').addEventListener('click', () => fetchData());
        setInterval(() => fetchData(), 30000);
        datePicker.addEventListener('change', () => fetchData());
    });

    async function fetchData() {
        const feed = document.getElementById('live-feed');
        const statusText = document.getElementById('status-text');
        const refreshBtn = document.getElementById('refresh-btn');
        const datePicker = document.getElementById('date-picker');
        const activeUsersList = document.getElementById('active-users-list');

        const selectedISODate = datePicker.value; 
        const searchDateStr = formatDateForSearch(selectedISODate); 

        if (!SHEETS_API_URL.startsWith('http')) {
            feed.innerHTML = '<div style="padding: 3rem; text-align: center; color: #ef4444; font-weight: 600; background: white; border-radius: 16px;">Eroare: Adaugă link-ul Google Apps Script în fișier.</div>';
            return;
        }

        try {
            statusText.innerText = "SE ÎNCARCĂ...";
            refreshBtn.style.opacity = "0.5";

            const response = await fetch(SHEETS_API_URL);
            const data = await response.json();

            if (data.error) throw new Error(data.error);

            const todaysData = data.reverse().filter(row => {
                const rowDate = row.DATA || row.Data || row['Marcaj de timp'] || row.Timestamp || ""; 
                return String(rowDate).includes(searchDateStr);
            });

            renderData(todaysData);
            
            const currentISO = new Date().toISOString().split('T')[0];
            statusText.innerText = (selectedISODate === currentISO) ? "LIVE" : "ISTORIC";
            document.getElementById('last-update').innerText = new Date().toLocaleTimeString('ro-RO', {hour: '2-digit', minute:'2-digit'});
        } catch (err) {
            console.error("Eroare preluare date: ", err);
            statusText.innerText = "OFFLINE";
            feed.innerHTML = `<div style="padding: 3rem; text-align: center; color: #ef4444; font-weight: 600; background: white; border-radius: 16px;">Eroare API: ${err.message}</div>`;
            activeUsersList.innerHTML = '<span class="no-data" style="color: #ef4444;">Eroare la încărcare.</span>';
        } finally {
            refreshBtn.style.opacity = "1";
        }
    }

    function renderData(data) {
        const feed = document.getElementById('live-feed');
        const activeUsersList = document.getElementById('active-users-list');
        const datePicker = document.getElementById('date-picker');
        const searchDateStr = formatDateForSearch(datePicker.value);

        feed.innerHTML = '';
        activeUsersList.innerHTML = '';

        if (data.length === 0) {
            feed.innerHTML = `<div class="empty-state">Nicio activitate înregistrată pe ${searchDateStr}.</div>`;
            activeUsersList.innerHTML = `<span class="no-data">Niciun tehnician înregistrat pe ${searchDateStr}.</span>`;
            document.getElementById('total-users').innerText = "0";
            document.getElementById('total-actions').innerText = "0";
            return;
        }

        const uniqueUserNamesSet = new Set();
        const userDevices = {};
        const groupedData = {};

        data.forEach(d => {
            const u = d.USER || d.User || "Anonim";
            
            if (!groupedData[u]) groupedData[u] = [];
            groupedData[u].push(d);

            if (u && u.trim() !== "" && u.toLowerCase() !== "necunoscut" && u.toLowerCase() !== "anonim") {
                uniqueUserNamesSet.add(u);
                
                const actiuneRaw = d.ACTIUNE || d.Actiune || "";
                if (actiuneRaw.toUpperCase() === "LOGIN" && !userDevices[u]) {
                     const details = d.DETALII || d.Detalii || "";
                     if(details.includes("Mobil")) userDevices[u] = "Mobil";
                     else if (details.includes("Desktop")) userDevices[u] = "Desktop";
                     // Am eliminat opțiunea "N/A" de aici pentru a permite sistemului să caute 
                     // informația și în logările tale anterioare dacă ultima este incompletă!
                }
            }
        });

        // Dacă, după ce am verificat toate acțiunile de azi, chiar nu avem niciun dispozitiv înregistrat, abia acum punem "Nespecificat"
        uniqueUserNamesSet.forEach(u => {
            if (!userDevices[u]) userDevices[u] = "N/A";
        });

        // Transformare în listă și sortare alfabetică
        const sortedUsers = Array.from(uniqueUserNamesSet).sort((a, b) => a.localeCompare(b));

        // Actualizăm contoarele
        document.getElementById('total-users').innerText = sortedUsers.length;
        document.getElementById('total-actions').innerText = data.length;

        // Randare User Chips 
        if (sortedUsers.length > 0) {
            sortedUsers.forEach(user => {
                const initial = user.charAt(0).toUpperCase();
                let deviceIcon = '';
                const device = userDevices[user];
                if (device === "Mobil") deviceIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 4px; color: #059669;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>';
                else if (device === "Desktop") deviceIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 4px; color: #2563eb;"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>';
                
                activeUsersList.innerHTML += `
                    <div class="user-chip active-user">
                        <div class="chip-avatar">${initial}</div>
                        <span class="chip-name">${user}${deviceIcon}</span>
                    </div>
                `;
            });
        } else {
            activeUsersList.innerHTML = `<span class="no-data">Doar activitate neînregistrată (Vizitatori).</span>`;
        }

        // ==========================================
        // RANDARE TABEL ACTIVITATE (ACORDION PRIETENOS)
        // ==========================================
        let feedHTML = '';

        sortedUsers.forEach((user, index) => {
            const userActions = groupedData[user] || [];
            const initial = user.charAt(0).toUpperCase();
            const contentId = 'content-user-' + index;
            const cardId = 'card-user-' + index;

            let deviceBadge = '<span class="device-tag">Nespecificat</span>';
            const device = userDevices[user];
            if (device === "Mobil") deviceBadge = '<span class="device-tag mobile"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg> Mobil</span>';
            else if (device === "Desktop") deviceBadge = '<span class="device-tag desktop"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg> PC / Laptop</span>';

            feedHTML += `
                <div class="acc-card" id="${cardId}">
                    <div class="acc-header" onclick="toggleAccordion('${contentId}', '${cardId}')">
                        <div class="acc-header-left">
                            <div class="acc-avatar">${initial}</div>
                            <div class="acc-user-info">
                                <h3>${user}</h3>
                                <div class="acc-tags">${deviceBadge}</div>
                            </div>
                        </div>
                        <div class="acc-header-right">
                            <div class="acc-count-badge">${userActions.length} acțiuni</div>
                            <div class="acc-toggle-btn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </div>
                        </div>
                    </div>
                    
                    <div class="acc-content" id="${contentId}" style="max-height: 0px;">
                        <div class="acc-inner-wrapper">
            `;

            // Afișăm actiunile în interior, FĂRĂ coloana repetitivă cu utilizatorul
            userActions.forEach(row => { feedHTML += createInnerRowHTML(row); });

            feedHTML += `</div></div></div>`;
        });

        // Randăm acțiunile necunoscute la final (dacă există)
        const anonUsers = Object.keys(groupedData).filter(u => !sortedUsers.includes(u));
        if(anonUsers.length > 0) {
            let allAnonActions = [];
            anonUsers.forEach(u => { allAnonActions = allAnonActions.concat(groupedData[u]); });
            
            const contentId = 'content-anon';
            const cardId = 'card-anon';
            
            feedHTML += `
                <div class="acc-card anon-card" id="${cardId}">
                    <div class="acc-header" onclick="toggleAccordion('${contentId}', '${cardId}')">
                        <div class="acc-header-left">
                            <div class="acc-avatar anon-avatar">?</div>
                            <div class="acc-user-info">
                                <h3>Vizitatori Neînregistrați</h3>
                                <div class="acc-tags"><span class="device-tag">Anonim</span></div>
                            </div>
                        </div>
                        <div class="acc-header-right">
                            <div class="acc-count-badge">${allAnonActions.length} acțiuni</div>
                            <div class="acc-toggle-btn">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </div>
                        </div>
                    </div>
                    <div class="acc-content" id="${contentId}" style="max-height: 0px;">
                        <div class="acc-inner-wrapper">
            `;

            allAnonActions.forEach(row => { feedHTML += createInnerRowHTML(row); });

            feedHTML += `</div></div></div>`;
        }

        feed.innerHTML = feedHTML;
    }

    // Design-ul curat pentru rândurile din interiorul acordeonului
    function createInnerRowHTML(row) {
        const actiuneRaw = row.ACTIUNE || row.Actiune || "Info";
        const actiune = String(actiuneRaw).toUpperCase();
        const actionClass = actiune.toLowerCase().replace(/[^a-z0-9]/g, '-'); 
        const details = row.DETALII || row.Detalii || "-";
        
        let rawTime = row.DATA || row.Data || row['Marcaj de timp'] || "";
        // Curățăm puțin formatul orei dacă conține virgule
        let timeFormatted = rawTime;
        if (typeof rawTime === 'string' && rawTime.includes(',')) {
            timeFormatted = rawTime.split(',')[1]?.trim() || rawTime; 
        }

        let icon = '🖥️';
        if (actiune.includes('DOWNLOAD')) icon = '📄';
        if (actiune.includes('VIDEO')) icon = '🎬';
        if (actiune.includes('VIZUALIZARE')) icon = '📂';
        if (actiune.includes('LOGIN')) icon = '🟢';

        return `
            <div class="activity-row">
                <div class="act-time">${timeFormatted}</div>
                <div class="act-badge-container">
                    <span class="badge-status ${actionClass}"><span class="dot"></span>${actiune}</span>
                </div>
                <div class="act-details">
                    <span class="res-icon">${icon}</span>
                    <span class="details-text">${details}</span>
                </div>
            </div>
        `;
    }
</script>

<style>
    /* CSS SCOPED (Aplicat doar elementelor statice din pagină) */
    .admin-container { 
        background: #f4f7fa; 
        min-height: 100vh; 
        font-family: 'Roboto', sans-serif; 
        color: #1f2937; 
        overflow-x: hidden; 
        width: 100%;
        max-width: 100vw;
        box-sizing: border-box;
    }
    
    .admin-header { background: #003087; color: white; padding: 2.5rem 0; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
    .header-inner { max-width: 1250px; margin: 0 auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center; }
    
    .title-with-status { display: flex; align-items: center; gap: 15px; margin-bottom: 5px; }
    .title-with-status h1 { font-size: 1.75rem; font-weight: 900; letter-spacing: -0.5px; margin: 0; }
    
    .live-pulse { background: rgba(239, 68, 68, 0.2); color: #fca5a5; padding: 4px 10px; border-radius: 6px; font-size: 0.7rem; font-weight: 900; display: flex; align-items: center; gap: 6px; border: 1px solid rgba(239, 68, 68, 0.3); }
    .pulse-dot { width: 8px; height: 8px; background: #ef4444; border-radius: 50%; box-shadow: 0 0 0 rgba(239, 68, 68, 0.4); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); } }

    .brand-info p { opacity: 0.8; font-size: 0.95rem; font-weight: 400; margin: 0; }
    
    .header-actions { display: flex; align-items: center; gap: 15px; }
    .refresh-btn { background: #F4D03F; border: none; padding: 0.7rem 1.4rem; border-radius: 10px; color: #111827; font-weight: 800; font-size: 0.9rem; display: flex; align-items: center; gap: 8px; transition: all 0.2s ease; cursor: pointer; }
    .refresh-btn:hover { background: #fde047; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(244, 208, 63, 0.3); }

    .back-btn { background: rgba(255,255,255,0.1); padding: 0.7rem 1.4rem; border-radius: 10px; color: white; text-decoration: none; font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.2); transition: all 0.2s ease; }
    .back-btn:hover { background: white; color: #003087; transform: translateY(-2px); }

    .stats-content { max-width: 1250px; margin: 2.5rem auto 4rem auto; padding: 0 2rem; width: 100%; box-sizing: border-box; }
    
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .stat-card { background: white; padding: 1.5rem; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); display: flex; align-items: center; gap: 20px; transition: transform 0.2s; border: 1px solid #edf2f7; }
    .stat-card:hover { transform: translateY(-5px); }
    
    .stat-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; }
    .stat-icon.users { background: #ebf5ff; color: #003087; }
    .stat-icon.downloads { background: #fef3c7; color: #d97706; }
    .stat-icon.time { background: #f3e8ff; color: #7e22ce; }

    .stat-label { color: #64748b; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; display: block; }
    .stat-value { font-size: 2.5rem; font-weight: 900; color: #1e293b; line-height: 1.2; display: block; }
    .stat-indicator { font-size: 0.8rem; font-weight: 600; color: #94a3b8; }

    .active-users-section { margin-top: 2.5rem; background: linear-gradient(to right, #ffffff, #f8fafc); padding: 2rem 2.5rem; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.04); border: 1px solid #edf2f7; border-left: 6px solid #10b981; width: 100%; box-sizing: border-box; }
    .active-users-header { display: flex; align-items: center; gap: 15px; margin-bottom: 1.5rem; }
    .icon-wrapper { background: #d1fae5; color: #059669; padding: 12px; border-radius: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px rgba(5, 150, 105, 0.1); }
    .header-text-group { display: flex; flex-direction: column; }
    .section-title { font-size: 1.25rem; font-weight: 900; color: #0f172a; margin: 0; }
    .section-desc { font-size: 0.85rem; color: #64748b; margin: 4px 0 0 0; font-weight: 600; }
    .users-chips-container { display: flex; flex-wrap: wrap; gap: 15px; }

    .activity-section { margin-top: 3rem; width: 100%; box-sizing: border-box; }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .section-header h2 { font-size: 1.4rem; font-weight: 900; color: #0f172a; margin: 0; }
    
    .date-badge { background: #fff; color: #003087; padding: 8px 14px; border-radius: 12px; font-size: 0.9rem; font-weight: 800; border: 1px solid #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,0.03); font-family: inherit; cursor: pointer; outline: none; transition: all 0.2s; }
    .date-badge:focus, .date-badge:hover { border-color: #003087; box-shadow: 0 0 0 2px rgba(0, 48, 135, 0.1); }

    @media (max-width: 1024px) {
        .header-inner { flex-direction: column; gap: 20px; text-align: center; padding: 1.5rem 1rem; }
        .title-with-status { justify-content: center; flex-wrap: wrap; }
        .title-with-status h1 { font-size: 1.5rem; }
